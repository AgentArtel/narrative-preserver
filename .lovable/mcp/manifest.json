              "type": "string"
            },
            "landmarks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "centre",
                      "upstage",
                      "downstage",
                      "overhead",
                      "underfoot"
                    ]
